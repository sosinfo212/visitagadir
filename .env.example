# Copy to .env and fill in real values:
#   cp .env.example .env

# ─── Database (MySQL) ───────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/agadir_directory"

# ─── Public site URL (SEO canonicals, sitemap, emails) ──
# Use your production domain in production, e.g. https://visitagadir.info
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Admin panel ────────────────────────────────────────
ADMIN_PASSWORD="change-me-strong-admin-password"
ADMIN_SECRET_KEY="change-me-to-a-long-random-string-at-least-32-chars"

# ─── User auth (NextAuth) ───────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ─── SMTP (review / verification emails) ────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@example.com"

# Google Maps / Places API (New) — admin import from Google Maps
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Chrome extension import API (header X-Extension-Key)
EXTENSION_API_KEY="change-me-to-a-long-random-secret"
